{
	"start": {
		"port": 8080,
		"host": "localhost"
	},
	"build": {},
	"clean": {},
	"test": {},
	"help": {},
	"eslint-rules": {
		"@typescript-eslint/parameter-properties": [
			"error",
			{
				"allow": []
			}
		]
	},
	"lint-package-json-rules": {
		"prefer-absolute-version-devDependencies": "error"
	},
	"validate": {},
	"source-headers": {
		"active": false,
		"include": [
			"src/**/*.ts",
			"test/**/*.ts"
		],
		"exclude": [],
		"headerFile": "conf/source-file-header.txt"
	},
	"banner": {
		"active": false,
		"source": "src/cydran_copyright.txt",
		"targets": []
	},
	"common": {
		"type": "lib",
		"staticDirectory": "static",
		"distDirectory": "dist",
		"workDirectory": "target",
		"srcDirectory": "src",
		"testDirectory": "test",
		"staticFileExtensions": [
			"png",
			"svg",
			"jpg",
			"gif"
		],
		"textFileExtensions": [
			"html",
			"htm",
			"md",
			"txt"
		]
	}
}